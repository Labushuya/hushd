<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground for the Hushd wordmark.
  The wordmark is rendered offline from the JetBrains Mono Bold webfont
  (see app/src/main/res/mipmap-*/ic_launcher_foreground.png), so this
  file just references the density-specific bitmap. Android picks the
  matching density automatically.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_foreground"
    android:gravity="fill" />
